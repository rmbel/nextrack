# Copy to prototype/.env. Values here are placeholders.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=25
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8017/auth/spotify/callback
NEXTTRACK_ONLINE_CATALOG=1
# Identify your own installation to MusicBrainz, e.g. a maintained project URL.
MUSICBRAINZ_CONTACT=https://github.com/rmbel/nextrack

# The settings below are NOT loaded from this file. Export them in your shell
# or set them in your hosting provider only when using shared Redis / a snapshot.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# NEXTTRACK_STORAGE_PREFIX=nexttrack:preview
# NEXTTRACK_CATALOG_SNAPSHOT=deployment/data/catalog-runtime.json.gz
